---
# Secret: Model provider API keys (template)
#
# USAGE:
#   1. Copy this file to secret.yaml (without .example)
#   2. Replace placeholder values with base64-encoded secrets:
#      echo -n 'your-api-key' | base64
#   3. Apply: kubectl apply -f deploy/k8s/secret.yaml
#
# For production GitOps, consider Sealed Secrets or External Secrets Operator
# instead of committing real secrets to version control.
#
apiVersion: v1
kind: Secret
metadata:
  name: aionui-provider-keys
  namespace: aionui
  labels:
    app.kubernetes.io/name: aionui
type: Opaque
data:
  # Z.ai API key (base64-encoded)
  # echo -n 'your-zai-key' | base64
  ZAI_API_KEY: PHlvdXItemFpLWtleT4=
  # OpenRouter API key (base64-encoded)
  OPENROUTER_API_KEY: PHlvdXItb3BlbnJvdXRlci1rZXk+
  # DeepSeek API key (base64-encoded)
  DEEPSEEK_API_KEY: PHlvdXItZGVlcHNlZWsta2V5Pgo=
